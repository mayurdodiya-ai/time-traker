# Port for `npm run dev` / `npm start`
PORT=8000
# Local MongoDB, or a MongoDB Atlas connection string in production
MONGODB_URI=mongodb://127.0.0.1:27017/chronos
# Required in production: random string, 32+ chars  (node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
# Timezone used to assign timesheet "work dates" (defaults to the server's timezone)
# COMPANY_TZ=Asia/Kolkata
# Google sign-in (optional). Create an OAuth "Web application" client in Google Cloud Console and paste its Client ID here.
# Authorised JavaScript origins must include the address you open the app on (e.g. http://localhost:8000 and your production URL).
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Optional: only accept Google accounts of this Workspace domain
# GOOGLE_ALLOWED_DOMAIN=yourcompany.com

# Admin (owner) account, created automatically on server start if it does not exist
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=
